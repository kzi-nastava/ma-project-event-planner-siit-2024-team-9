<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="service"
            type="com.example.eventify.models.solutions.Service" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            tools:context=".YourActivity">

            <!-- Heading -->
            <TextView
                android:id="@+id/formHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="20dp"
                android:text="New service"
                android:theme="@style/header_text" />

            <!-- Name -->
            <EditText
                android:id="@+id/nameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@={service.name}"
                android:textColorHint="@color/black"
                android:selectAllOnFocus="true"
                android:textColor="@android:color/black"
                android:backgroundTint="@android:color/black"
                android:layout_marginBottom="20dp" />

            <!-- Category (DropDown) -->
            <Spinner
                android:id="@+id/categorySpinner1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:layout_marginStart="5dp"
                android:backgroundTint="@android:color/white" />

            <!-- New Category EditText (Initially hidden) -->
            <EditText
                android:id="@+id/newCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="New category name"
                android:textColorHint="@color/black"
                android:selectAllOnFocus="true"
                android:textColor="@android:color/black"
                android:backgroundTint="@android:color/black"
                android:layout_marginBottom="20dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/newCategoryDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="New category description"
                android:textColorHint="@color/black"
                android:selectAllOnFocus="true"
                android:textColor="@android:color/black"
                android:backgroundTint="@android:color/black"
                android:layout_marginBottom="20dp"
                android:visibility="gone" />

            <!-- Category (DropDown) -->
            <Spinner
                android:id="@+id/typeSpinner1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:layout_marginStart="5dp"
                android:backgroundTint="@android:color/white" />

            <!-- Description -->
            <EditText
                android:id="@+id/descriptionEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Description"
                android:textColorHint="@color/black"
                android:text="@={service.description}"
                android:inputType="textMultiLine"
                android:minLines="1"
                android:textColor="@android:color/black"
                android:backgroundTint="@android:color/black"
                android:layout_marginBottom="20dp" />

            <!-- Specificities -->
            <EditText
                android:id="@+id/specifitiesEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Specificities"
                android:textColorHint="@color/black"
                android:inputType="textMultiLine"
                android:text="@={service.specifity}"
                android:minLines="1"
                android:textColor="@android:color/black"
                android:backgroundTint="@android:color/black"
                android:layout_marginBottom="20dp" />

            <!-- Price and Discount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/priceEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Price"
                    android:text="@={`` + service.price}"
                    android:textColorHint="@color/black"
                    android:inputType="numberDecimal"
                    android:textColor="@android:color/black"
                    android:backgroundTint="@android:color/black"
                    android:layout_marginBottom="20dp" />

                <EditText
                    android:id="@+id/discountEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Discount"
                    android:text="@={`` + service.discount}"
                    android:textColorHint="@color/black"
                    android:inputType="numberDecimal"
                    android:textColor="@android:color/black"
                    android:backgroundTint="@android:color/black"
                    android:layout_marginBottom="20dp" />
            </LinearLayout>

            <!-- Profile Image Section -->
            <LinearLayout
                android:id="@+id/profileImageLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <ImageButton
                    android:id="@+id/serviceImage"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/add"
                    android:background="@drawable/photos_holder"
                    android:contentDescription="@string/profile_picture"
                    android:scaleType="centerInside" />

                <!-- Switches for Visibility and Availability -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/visibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visibility"
                        android:checked="@{service.visibility}"
                        android:textColor="@android:color/black"
                        android:thumbTint="@color/black"
                        android:trackTint="@color/black"
                        android:layout_marginBottom="20dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/availability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Availability"
                        android:checked="@{service.availability}"
                        android:textColor="@android:color/black"
                        android:thumbTint="@color/black"
                        android:trackTint="@color/black"
                        android:layout_marginBottom="20dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:hint="Duration"
                        android:textColorHint="@color/black"
                        android:minLines="1"
                        android:textColor="@android:color/black"
                        android:backgroundTint="@android:color/black" />
                    <EditText
                        android:id="@+id/durationInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text='@={`` + service.duration}'
                        android:textColor="@color/black"
                        />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:weightSum="2">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/min"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:hint="Min engagement"
                        android:textColorHint="@color/black"
                        android:minLines="1"
                        android:textColor="@android:color/black"
                        android:backgroundTint="@android:color/black" />
                    <EditText
                        android:id="@+id/minInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text='@={ (`` + service.minEngagement)}'>

                    </EditText>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/max"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:hint="Max engagement"
                        android:textColorHint="@color/black"
                        android:minLines="1"
                        android:textColor="@android:color/black"
                        android:backgroundTint="@android:color/black" />
                    <EditText
                        android:id="@+id/maxInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text='@={`` + service.maxEngagement}'
                        android:textColor="@color/black"
                        />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:weightSum="2">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/reservation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:hint="Reservation deadline"
                        android:textColorHint="@color/black"
                        android:minLines="1"
                        android:textColor="@android:color/black"
                        android:backgroundTint="@android:color/black" />
                    <EditText
                        android:id="@+id/reservationInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text='@={`` + service.reservationDeadline}'>

                    </EditText>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/cancel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:hint="Cancellation deadline"
                        android:textColorHint="@color/black"
                        android:minLines="1"
                        android:textColor="@android:color/black"
                        android:backgroundTint="@android:color/black" />
                    <EditText
                        android:id="@+id/cancelInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text='@={`` + service.cancellationDeadline}'
                        android:textColor="@color/black"
                        />
                </LinearLayout>

            </LinearLayout>


            <!-- Confirmation Options -->
            <TextView
                android:id="@+id/radioButtonLabelTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Booking confirmation"
                android:textColor="@android:color/black" />

            <android.widget.RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="40dp">

                <android.widget.RadioButton
                    android:id="@+id/automatic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Automatic"
                    android:textColor="@android:color/black" />

                <android.widget.RadioButton
                    android:id="@+id/manual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Manual"
                    android:textColor="@android:color/black" />
            </android.widget.RadioGroup>

            <!-- Submit and Delete Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="60dp">

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit"
                    android:backgroundTint="@color/black"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/red"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_marginBottom="20dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
