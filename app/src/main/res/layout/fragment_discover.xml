<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

   

    <!-- Scrollable container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <!-- Top 5 Events Section -->
            <TextView
                android:id="@+id/top_events_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="Top 5 Events"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:id="@+id/top_events_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- All Events Section -->
            <TextView
                android:id="@+id/all_events_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="All Events"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:id="@+id/all_events_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Top 5 Solutions Section -->
            <TextView
                android:id="@+id/top_solutions_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="Top 5 Solutions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:id="@+id/top_solutions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- All Solutions Section -->
            <TextView
                android:id="@+id/all_solutions_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="All Solutions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:id="@+id/all_solutions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</LinearLayout>
